DATABASE_URL="postgresql://delicias:delicias_secret@localhost:5432/delicias_db?schema=public"
REDIS_URL="redis://localhost:6379"

# JWT
JWT_ACCESS_SECRET="troque_por_secret_forte_256bits"
JWT_REFRESH_SECRET="troque_por_outro_secret_forte_256bits"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# App
PORT=3000
NODE_ENV=development
CORS_ORIGINS="http://localhost:5173"
APP_BASE_URL="http://localhost"
FRONTEND_URL="http://localhost:5173"

# Pagamento
ABACATE_PAY_API_KEY="sua_chave_aqui"
ABACATE_PAY_WEBHOOK_SECRET="seu_hmac_secret_aqui"
ABACATE_PAY_BASE_URL="https://api.abacatepay.com"

# WhatsApp
WHATSAPP_TOKEN="seu_token_aqui"
WHATSAPP_PHONE_NUMBER_ID="seu_phone_id"
WHATSAPP_VERIFY_TOKEN="token_de_verificacao"

# SMS (Twilio)
TWILIO_ACCOUNT_SID="ACxxxxxxxxxx"
TWILIO_AUTH_TOKEN="seu_auth_token"
TWILIO_FROM_NUMBER="+55119xxxxxxxx"

# Email (Mailhog em dev)
MAIL_HOST="localhost"
MAIL_PORT=1025
MAIL_USER=""
MAIL_PASS=""
MAIL_FROM="noreply@deliciasdavann.com.br"

# Logística
UBER_DIRECT_API_KEY="sua_chave_uber"
UBER_DIRECT_BASE_URL="https://api.uber.com/v1/deliveries"

# AWS (produção)
AWS_ACCESS_KEY_ID="sua_key"
AWS_SECRET_ACCESS_KEY="seu_secret"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="delicias-da-vann-files"

# Fiscal (produção) — desligado por padrão; setar true quando a empresa começar a emitir
FISCAL_ENABLED="false"
NFE_API_KEY="sua_chave_nfe"
NFE_BASE_URL="https://api.focusnfe.com.br/v2"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/api/v1/auth/google/callback"

# Empresa (usada no WhatsApp-first e em NF-e)
EMPRESA_WHATSAPP="5511982813152"

# Clima (OpenWeather) — opcional; sem chave a previsao de clima e ignorada
OPENWEATHER_API_KEY=""
OPENWEATHER_LAT="-23.55"
OPENWEATHER_LON="-46.63"

# Storage (MinIO em dev, S3/R2 em prod)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=admin
S3_SECRET_KEY=changeme123
S3_BUCKET=uploads
S3_FORCE_PATH_STYLE=true
CDN_BASE_URL=http://localhost/cdn
